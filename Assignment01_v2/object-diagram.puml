@startuml
title Employee Management System - Object Diagram
skinparam objectAttributeIconSize 0
skinparam monochrome true

object "emp101 : Employee" as emp {
  employeeId = "EMP101"
  name = "Rahul Sharma"
  password = "******"
  status = ACTIVE
  email = "rahul@company.com"
}

object "admin01 : Admin" as admin {
  adminId = "ADM01"
  name = "Priya Singh"
  password = "******"
  role = "Administrator"
}

object "task501 : Task" as task {
  taskId = "T501"
  title = "Prepare monthly report"
  description = "Complete and submit the report"
  dueDate = "2026-08-15"
  progress = 80
}

object "penalty01 : Penalty" as penalty {
  penaltyId = "P01"
  reason = "Late task completion"
  delayDays = 2
  amount = 500.0
}

object "payrollAug : Payroll" as payroll {
  payrollId = "PAY-AUG-101"
  month = "August 2026"
  basicSalary = 40000.0
  earnings = 5000.0
  deductions = 3000.0
  netSalary = 41500.0
}

object "slipAug : SalarySlip" as slip {
  slipId = "SLIP-AUG-101"
  issueDate = "2026-08-31"
  grossSalary = 45000.0
  deductions = 3000.0
  penaltyAmount = 500.0
  netSalary = 41500.0
}

admin -- task : assigns
emp -- task : receives
task -- penalty : incurs
emp -- payroll : payroll for
payroll -- penalty : includes
payroll -- slip : generates
emp -- slip : views
@enduml
